@@ -1,8 +1,47 @@
 'use strict';
 
-// CSV 解析。当前只做了最朴素的逗号切分，引号里的逗号会切错。
 function parse(text) {
-  return text.trim().split('\n').map((line) => line.split(','));
+  const rows = [];
+  let row = [];
+  let field = '';
+  let inQuotes = false;
+
+  for (let i = 0; i < text.length; i += 1) {
+    const char = text[i];
+
+    if (inQuotes) {
+      if (char === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i += 1;
+        } else {
+          inQuotes = false;
+        }
+      } else {
+        field += char;
+      }
+    } else if (char === '"' && field.length === 0) {
+      inQuotes = true;
+    } else if (char === ',') {
+      row.push(field);
+      field = '';
+    } else if (char === '\n' || char === '\r') {
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+      if (char === '\r' && text[i + 1] === '\n') i += 1;
+    } else {
+      field += char;
+    }
+  }
+
+  if (inQuotes) throw new Error('CSV contains an unterminated quoted field');
+  if (field.length > 0 || row.length > 0 || (text.length > 0 && text[text.length - 1] !== '\n' && text[text.length - 1] !== '\r')) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows;
 }
 
 module.exports = { parse };
