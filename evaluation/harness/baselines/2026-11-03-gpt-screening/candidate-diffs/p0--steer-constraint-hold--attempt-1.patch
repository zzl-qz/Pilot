   assert.deepEqual(parse('a,"第一行\n第二行"'), [['a', '第一行\n第二行']]);
 });
 
+test('支持双引号转义、CRLF 和末尾换行', () => {
+  assert.deepEqual(parse('a,b\r\n"他说""你好",x\r\n'), [['a', 'b'], ['他说"你好', 'x']]);
+});
+
+test('保留字段内及字段外空白，并解析空字段', () => {
+  assert.deepEqual(parse(' a ,," b "'), [[' a ', '', ' b ']]);
+});
+
+test('未闭合的引号字段报错', () => {
+  assert.throws(() => parse('a,"b'), /unterminated quoted field/);
+});
+
