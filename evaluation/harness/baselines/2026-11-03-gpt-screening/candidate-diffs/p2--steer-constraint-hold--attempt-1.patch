+test('支持双引号转义和 CRLF 行结束符', () => {
+  assert.deepEqual(parse('a,b\r\n"他说""好",c'), [['a', 'b'], ['他说"好', 'c']]);
+});
+
+test('保留空字段且忽略末尾换行产生的空记录', () => {
+  assert.deepEqual(parse('a,,\n,\r\n'), [['a', '', ''], ['', '']]);
+});
+
+test('未闭合的引号字段会报错', () => {
+  assert.throws(() => parse('a,"未结束'), /unterminated quoted field/);
+});
+
