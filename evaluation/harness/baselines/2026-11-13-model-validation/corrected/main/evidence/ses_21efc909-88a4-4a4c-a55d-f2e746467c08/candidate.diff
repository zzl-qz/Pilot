-  return text.trim().split('\n').map((line) => line.split(','));
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false; // 当前字段是否处于引号内
+  let fieldStarted = false; // 当前是否已经开始出现字段（用于区分空文本与空行）
+
+  const endField = () => {
+    row.push(field);
+    field = '';
+    fieldStarted = true;
+  };
+  const endRow = () => {
+    endField();
+    rows.push(row);
+    row = [];
+    fieldStarted = false; // 新一行尚未开始，避免结尾换行后再补一个空行
+  };
+
+  for (let i = 0; i < text.length; i += 1) {
+    const ch = text[i];
+
+    if (quoted) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') {
+          field += '"'; // "" 转义
+          i += 1;
+        } else {
+          quoted = false; // 闭合引号
+        }
+      } else {
+        field += ch; // 引号内的逗号、换行都按字面保留
+      }
+      continue;
+    }
+
+    if (ch === '"' && field === '') {
+      quoted = true;
+      fieldStarted = true;
+    } else if (ch === ',') {
+      endField();
+    } else if (ch === '\r' || ch === '\n') {
+      if (ch === '\r' && text[i + 1] === '\n') i += 1;
+      endRow();
+    } else {
+      field += ch;
+      fieldStarted = true;
+    }
+  }
+
+  // 末尾还有未收尾的字段或字段已开始（如 "a,"），则补最后一行；
+  // 若文本以换行结束，循环里已 endRow，不会多出空行。
+  if (field !== '' || fieldStarted) endRow();
+
+  return rows;
