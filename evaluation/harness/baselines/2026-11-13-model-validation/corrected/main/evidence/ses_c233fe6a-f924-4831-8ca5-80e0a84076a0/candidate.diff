 'use strict';
 
-// CSV 解析。当前只做了最朴素的逗号切分，引号里的逗号会切错。
+// CSV 解析：逐字符状态机，支持引号内的逗号与换行，"" 表示字段内的引号。
+// 引号外的行尾 \r（CRLF）会被忽略；首尾空白会被去除（空白输入返回空数组）。
 function parse(text) {
-  return text.trim().split('\n').map((line) => line.split(','));
+  const input = String(text).trim();
+  if (input === '') return [];
+
+  const rows = [];
+  let row = [];
+  let field = '';
+  let quoted = false; // 当前字段是否处于双引号内
+  let i = 0;
+
+  const endField = () => {
+    row.push(field);
+    field = '';
+  };
+  const endRow = () => {
+    endField();
+    rows.push(row);
+    row = [];
+  };
+
+  while (i < input.length) {
+    const ch = input[i];
+
+    if (quoted) {
+      if (ch === '"') {
+        if (input[i + 1] === '"') { // "" -> 字段内的一个引号
+          field += '"';
+          i += 2;
+        } else { // 闭合引号
+          quoted = false;
+          i += 1;
+        }
+      } else {
+        field += ch; // 引号内的逗号、换行都原样保留
+        i += 1;
+      }
+      continue;
+    }
+
+    if (ch === '"' && field === '') { // 字段起始处的引号开启引号模式
+      quoted = true;
+      i += 1;
+    } else if (ch === ',') {
+      endField();
+      i += 1;
+    } else if (ch === '\r' && input[i + 1] === '\n') {
+      endRow();
+      i += 2;
+    } else if (ch === '\n' || ch === '\r') {
+      endRow();
+      i += 1;
+    } else {
+      field += ch;
+      i += 1;
+    }
+  }
+
+  // 收尾：最后一段 field/row 非空，或输入以分隔符结束（如尾随换行/逗号）时补上
+  if (field !== '' || row.length > 0) endRow();
+
+  return rows;
 }
 
 module.exports = { parse };
