+// CSV 解析：逐字符扫描，引号内的逗号不切分，引号内换行保留在同一字段，"" 转义为 "。
 function parse(text) {
-  return text.trim().split('\n').map((line) => line.split(','));
+  const rows = [];
+  let row = [];
+  let field = '';
+  let inQuotes = false;
+
+  const pushField = () => {
+    row.push(field);
+    field = '';
+  };
