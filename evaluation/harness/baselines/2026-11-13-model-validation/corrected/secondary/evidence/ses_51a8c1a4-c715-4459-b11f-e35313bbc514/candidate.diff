+    pushField();
+    rows.push(row);
+    row = [];
+  };
+
+  for (let i = 0; i < text.length; i += 1) {
+    const ch = text[i];
+    if (inQuotes) {
+      if (ch === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i += 1;
+        } else {
+          inQuotes = false;
+        }
+      } else {
+        field += ch;
+      }
+    } else if (ch === '"') {
+      inQuotes = true;
+    } else if (ch === ',') {
+      pushField();
+    } else if (ch === '\r') {
+      if (text[i + 1] === '\n') i += 1;
+      pushRow();
+    } else if (ch === '\n') {
+      pushRow();
+    } else {
+      field += ch;
+    }
+  }
+  if (field !== '' || row.length > 0) pushRow();
+  return rows;
 }
 
