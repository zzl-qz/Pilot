+test('连续两个双引号是转义的字面引号', () => {
+  // RFC 4180：字段 他说"你好" 的合法写法是 "他说""你好"""（末三个引号 = 转义一个 + 闭合一个）
+  assert.deepEqual(parse('a,"他说""你好""",b'), [['a', '他说"你好"', 'b']]);
+});
+
+test('CRLF 换行与末尾换行不产生空行', () => {
+  assert.deepEqual(parse('a,b\r\n1,2\r\n'), [['a', 'b'], ['1', '2']]);
+});
+
+test('空输入得到空结果，空字段保留', () => {
+  assert.deepEqual(parse(''), []);
+  assert.deepEqual(parse('a,,b'), [['a', '', 'b']]);
+});
+
