@@ -0,0 +1,9 @@
+'use strict';
+
+// 金额格式化的唯一实现：分转元，带 ¥ 前缀，固定两位小数。
+// invoice 与 receipt 共用此函数，改这里两边同时生效。
+function formatCents(cents) {
+  return `¥${(cents / 100).toFixed(2)}`;
