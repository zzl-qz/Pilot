--- a/src/pricingStrategies.js
+++ b/src/pricingStrategies.js
@@ -0,0 +1,33 @@
+'use strict';
+
+// 价格策略注册表：每种会员类型对应一个 (order) => 价格 的函数。
+// 新增会员类型时只需在这里（或通过 register）注册策略，不需要改 orderService。
+
+// 未注册类型的兜底策略：按原价取整，与原 priceFor 行为一致。
+function defaultStrategy(order) {
+  return Math.round(order.base);
+}
+
+const strategies = new Map([
+  ['vip', (order) => Math.round(order.base * 0.8)],
+  ['member', (order) => Math.round(order.base * 0.9)],
+  ['employee', (order) => Math.round(order.base * 0.5)],
+]);
+
+// 注册/覆盖一种类型的价格策略
+function register(type, strategy) {
+  if (typeof type !== 'string' || type === '') {
+    throw new TypeError('strategy type must be a non-empty string');
+  }
+  if (typeof strategy !== 'function') {
+    throw new TypeError('strategy must be a function');
+  }
+  strategies.set(type, strategy);
+}
+
+// 取某类型的策略，未知类型退回原价策略
+function forType(type) {
+  return strategies.get(type) || defaultStrategy;
+}
+
+module.exports = { register, forType };
