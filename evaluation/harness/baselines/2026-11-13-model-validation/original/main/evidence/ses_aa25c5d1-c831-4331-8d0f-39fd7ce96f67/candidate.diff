--- a/src/pricingStrategies.js
+++ b/src/pricingStrategies.js
@@ -0,0 +1,30 @@
+'use strict';
+
+// 价格策略注册表：每种会员类型对应一个策略函数 (order) => 价格。
+// 新增会员类型时在这里（或通过 register）注册即可，不需要改 orderService。
+const strategies = new Map();
+
+// 未知类型退回原价（四舍五入），保持与原 priceFor 的兜底行为一致。
+function defaultStrategy(order) {
+  return Math.round(order.base);
+}
+
+function register(type, strategy) {
+  if (typeof type !== 'string' || type === '') {
+    throw new TypeError('register: type 必须是非空字符串');
+  }
+  if (typeof strategy !== 'function') {
+    throw new TypeError('register: strategy 必须是函数 (order) => 价格');
+  }
+  strategies.set(type, strategy);
+}
+
+function forType(type) {
+  return strategies.get(type) || defaultStrategy;
+}
+
+register('vip', (order) => Math.round(order.base * 0.8));
+register('member', (order) => Math.round(order.base * 0.9));
+register('employee', (order) => Math.round(order.base * 0.5));
+
+module.exports = { register, forType };
