 'use strict';
 
-const { resolve } = require('node:path');
+const { resolve, sep } = require('node:path');
 
 /**
  * 把用户给出的相对路径解析成工作区内的绝对路径。
  * 逃出工作区的路径必须返回 null（不抛异常），调用方自行处理。
  */
 function resolveInside(root, userPath) {
-  return resolve(root, userPath);
+  const rootPath = resolve(root);
+  let target;
+  try {
+    target = resolve(rootPath, userPath);
+  } catch {
+    return null;
+  }
+  if (target === rootPath) return rootPath;
+  if (target.startsWith(rootPath + sep)) return target;
+  return null;
 }
 
 module.exports = { resolveInside };
