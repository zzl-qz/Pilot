+          field += '"'; // 转义引号
+          i++;
+        } else {
+          inQuotes = false; // 闭合引号
+        }
+      } else {
+        field += ch; // 引号内的逗号与换行原样保留
+      }
+      continue;
+    }
+
+    if (ch === '"' && atFieldStart) {
+      inQuotes = true; // 字段开头的引号是包裹引号
+    } else if (ch === ',') {
+      endField();
