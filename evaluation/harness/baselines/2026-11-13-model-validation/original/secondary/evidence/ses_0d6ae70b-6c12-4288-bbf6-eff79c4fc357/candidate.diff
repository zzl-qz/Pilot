--- a/src/pricingStrategies.js
+++ b/src/pricingStrategies.js
@@ -0,0 +1,26 @@
+'use strict';
+
+// 价格策略注册表：每种会员类型对应一个 (order) => price 的策略函数。
+// 新增会员类型时调用 registerStrategy 即可，无需改动下单服务。
+const registry = new Map([
+  ['vip', (order) => Math.round(order.base * 0.8)],
+  ['member', (order) => Math.round(order.base * 0.9)],
+  ['employee', (order) => Math.round(order.base * 0.5)],
+]);
+
+// 注册（或覆盖）一种类型的价格策略。
+function registerStrategy(type, fn) {
+  registry.set(type, fn);
+  return fn;
+}
+
+// 取某类型的策略；未注册时返回按原价计费（与原 orderService 行为一致）。
+function forType(type) {
+  const strategy = registry.get(type);
+  if (strategy) {
+    return strategy;
+  }
+  return (order) => Math.round(order.base);
+}
+
+module.exports = { registerStrategy, forType };
