+  let startIndex = 0;
+  if (cursor != null) {
+    const idx = items.findIndex((item) => item.id === cursor);
+    if (idx === -1) {
+      // 游标 id 不在当前列表中（可能被删除），从头开始
+      startIndex = 0;
+    } else {
+      startIndex = idx + 1;
+    }
+  }
+
+  const slice = items.slice(startIndex, startIndex + limit);
