--- a/src/pricingStrategies.js
+++ b/src/pricingStrategies.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// 价格策略表：key 为订单 type，value 为 (order) => 价格。
+// 新增会员类型时在这里加一条，或运行时通过 orderService.registerStrategy 注册，
+// 都不需要再改 priceFor。
+const strategies = new Map([
+  ['vip', (order) => Math.round(order.base * 0.8)],
+  ['member', (order) => Math.round(order.base * 0.9)],
+  ['employee', (order) => Math.round(order.base * 0.5)],
+]);
+
+function register(type, fn) {
+  strategies.set(type, fn);
+  return strategies;
+}
+
+function forType(type) {
+  return strategies.get(type) || ((order) => Math.round(order.base));
+}
+
+module.exports = { strategies, register, forType };
