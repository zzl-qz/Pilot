{
  "name": "pilot-desktop",
  "productName": "Pilot",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "node start.mjs",
    "postinstall": "node prepare-runtime.mjs",
    "test": "node --check main.mjs && node --test \"test/*.test.mjs\"",
    "smoke": "node test/smoke/smoke.mjs",
    "test:ui": "node test/smoke/ui-smoke.mjs",
    "test:browser": "node browser-viewport-smoke.mjs",
    "test:security": "node test/smoke/security-smoke.mjs",
    "test:host": "node ../scripts/verify-desktop-host.mjs",
    "package:release": "node ../scripts/package-desktop-release.mjs --verify"
  },
  "devDependencies": {
    "electron": "45.2.1"
  }
}
