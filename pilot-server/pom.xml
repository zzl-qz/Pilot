<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pilot</groupId>
        <artifactId>pilot</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>pilot-server</artifactId>
    <properties>
        <!-- 后端构建时是否跳过前端构建；纯后端迭代可用 -DskipFrontend=true -->
        <skipFrontend>false</skipFrontend>
        <!-- 前端工程目录（相对 pilot-server） -->
        <frontendDir>${project.basedir}/../pilot-web/frontend</frontendDir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.pilot</groupId>
            <artifactId>pilot-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- 只构建本模块时，classpath 上的 pilot-core 是仓库里的 jar，可能落后于源码。
                 把 core 的资源一并打进本模块，运行时以这里的为准。 -->
            <resource>
                <directory>../pilot-core/src/main/resources</directory>
            </resource>
            <resource>
                <directory>../pilot-web/src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 前端依赖与构建：
                 validate 阶段先问「要不要重新拉取前端依赖」（受 skipFrontend 之外的独立开关控制，
                 所以 IDE 里跑 spring-boot:run 也一定会看到），
                 generate-resources 阶段再 npm run build 进 static/。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>frontend-deps-ask</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <!-- 覆盖插件级的 skip：即使 -DskipFrontend=true 也要问一次 -->
                            <skip>false</skip>
                            <!-- 继承 Maven 的 stdin，IDE 运行控制台里也能输入选择 -->
                            <inheritIo>true</inheritIo>
                            <workingDirectory>${project.basedir}/..</workingDirectory>
                            <executable>node</executable>
                            <arguments><argument>tools/ask-frontend-deps.mjs</argument></arguments>
                            <!-- 没装 Node 的环境（纯后端迭代）直接跳过，不要把构建搞挂 -->
                            <successCodes>0,127,9009</successCodes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${frontendDir}</workingDirectory>
                            <executable>npm</executable>
                            <arguments><argument>run</argument><argument>build</argument></arguments>
                            <environmentVariables>
                                <CI>true</CI>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 同一进程里编译 core 源码，不再另起一次 Maven 去 install。
                 另起的 Maven 会和 IDEA 这次构建抢 ~/.m2 的锁，启动直接失败。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-core-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../pilot-core/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JDK 25 显式预加载 Mockito agent，避免依赖运行中的动态挂载。
                         混用 mock maker 的断言缺陷由父 pom 中的 Mockito 修复版本处理。 -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- true 会加上 -XX:TieredStopAtLevel=1，热代码不进 C2，长任务更吃 CPU。 -->
                    <optimizedLaunch>false</optimizedLaunch>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
