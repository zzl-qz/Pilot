<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pilot</groupId>
        <artifactId>pilot</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>pilot-server</artifactId>
    <properties>
        <!-- 后端构建时是否跳过前端构建；纯后端迭代可用 -DskipFrontend=true -->
        <skipFrontend>false</skipFrontend>
        <!-- 前端工程目录（相对 pilot-server） -->
        <frontendDir>${project.basedir}/../pilot-web/frontend</frontendDir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.java-diff-utils</groupId>
            <artifactId>java-diff-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
        </dependency>
        <!-- server 直接编译 core 源码，@Slf4j 的注解处理器这里也要有。 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.pilot</groupId>
            <artifactId>pilot-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.50.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <!-- 只构建本模块时，classpath 上的 pilot-core 是仓库里的 jar，可能落后于源码。
                 把 core 的资源一并打进本模块，运行时以这里的为准。 -->
            <resource>
                <directory>../pilot-core/src/main/resources</directory>
            </resource>
            <resource>
                <directory>../pilot-web/src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <!-- 删除上次构建遗留的带 hash 资源，避免增量复制累积旧 bundle。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-static-assets</id>
                        <phase>generate-resources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/static/assets" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 在复制静态资源前检查锁定的依赖，并按需构建前端。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <skip>${skipFrontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>frontend-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <workingDirectory>${frontendDir}</workingDirectory>
                            <executable>node</executable>
                            <arguments>
                                <argument>scripts/build.mjs</argument>
                                <argument>--if-needed</argument>
                            </arguments>
                            <environmentVariables>
                                <CI>true</CI>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JDK 25 显式预加载 Mockito agent，避免依赖运行中的动态挂载。
                         混用 mock maker 的断言缺陷由父 pom 中的 Mockito 修复版本处理。 -->
                    <argLine>"-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar" --enable-native-access=ALL-UNNAMED</argLine>
                    <!-- 单元测试不探测外部模型服务；隔离 HTTP 用例和后台验收显式验证自动发现。 -->
                    <systemPropertyVariables>
                        <pilot.model.capability-discovery.enabled>false</pilot.model.capability-discovery.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- true 会加上 -XX:TieredStopAtLevel=1，热代码不进 C2，长任务更吃 CPU。 -->
                    <optimizedLaunch>false</optimizedLaunch>
                    <!-- spring-boot:run 在拉起 JVM 前已经执行过 Maven 生命周期。 -->
                    <systemPropertyVariables>
                        <pilot.frontend.prepare>false</pilot.frontend.prepare>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
