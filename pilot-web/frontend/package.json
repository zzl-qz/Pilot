{
  "name": "pilot-web-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "test:delivery": "node --import ./scripts/register-typescript.mjs --test scripts/agent-delivery.test.mjs",
    "test:models": "node scripts/model-discovery-smoke.mjs",
    "test:refresh": "node scripts/workbench-refresh-smoke.mjs",
    "test:mobile": "node scripts/mobile-connection-smoke.mjs",
    "test:usage": "node --import ./scripts/register-typescript.mjs --test scripts/request-usage.test.mjs && node scripts/request-usage-smoke.mjs",
    "test:agents": "node --import ./scripts/register-typescript.mjs --test scripts/agent-events.test.mjs && node scripts/agent-usage-smoke.mjs",
    "test:automation": "node scripts/p1-smoke.mjs",
    "test:notifications": "node scripts/notification-smoke.mjs",
    "test:results": "node scripts/results-smoke.mjs",
    "test:schedules": "node scripts/schedule-smoke.mjs",
    "test:composer": "node scripts/composer-smoke.mjs",
    "dev:ui": "vite",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:interaction": "node scripts/interaction-smoke.mjs",
    "test:navigation": "node scripts/navigation-smoke.mjs",
    "test:scroll": "node scripts/thread-scroll-smoke.mjs",
    "test:sessions": "node scripts/session-management-smoke.mjs",
    "test:style": "node scripts/workbench-style-smoke.mjs",
    "test:products": "node scripts/work-products-smoke.mjs",
    "test:recovery": "node scripts/sandbox-recovery-smoke.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test:unit": "node scripts/verify-migration.mjs --unit-only",
    "test:migration": "node scripts/verify-migration.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@stylexjs/stylex": "0.19.1",
    "immer": "^10.1.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^6.0.7"
  }
}
